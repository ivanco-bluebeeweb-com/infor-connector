      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "infor.provider.connected"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "Friendly tenant label, e.g. 'Acme Production'.",
            "title": "Label",
            "type": "string"
          },
          "portal_url": {
            "description": "ION portal/token URL (the 'pu' field from your .ionapi file), e.g. https://mingle-ionapi.inforcloudsuite.com.",
            "title": "Portal Url",
            "type": "string"
          },
          "tenant_id": {
            "description": "ION tenant ID (the 'ti' field from your .ionapi file).",
            "title": "Tenant Id",
